{
  "name": "oh-my-clm",
  "version": "0.1.0",
  "description": "A Pi extension and minimal DSH bridge for self-editable live context inspired by the Facebook Research CLM harness.",
  "icon": "./icon.svg",
  "private": true,
  "type": "module",
  "files": [
    "README.md",
    "docs",
    "extensions/clm.ts",
    "src/context-format.ts",
    "src/dsh-bridge.ts",
    "dsh",
    "dist",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "clm"
  ],
  "pi": {
    "extensions": [
      "./extensions/clm.ts"
    ]
  },
  "main": "./dist/dsh/index.js",
  "exports": {
    ".": "./dist/dsh/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:dsh": "tsc -p tsconfig.dsh.json",
    "check": "npm run build:dsh && node --experimental-strip-types --check extensions/clm.ts && node --experimental-strip-types --check src/context-format.ts && node --experimental-strip-types --check src/dsh-bridge.ts && node --check dist/dsh/index.js && node scripts/check-dsh-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dsh.json --noEmit",
    "prepack": "npm run build:dsh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}

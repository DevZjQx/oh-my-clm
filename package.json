{
  "name": "oh-my-clm",
  "version": "0.1.7",
  "description": "A Pi extension and minimal DSH bridge for self-editable live context inspired by the Facebook Research CLM harness.",
  "icon": "./icon.svg",
  "type": "module",
  "files": [
    "README.md",
    "changelog.md",
    "docs/README.md",
    "docs/how-it-works.md",
    "docs/project-structure.md",
    "docs/CLM技术分析表.md",
    "docs/dsh-cache-explained.md",
    "docs/reports",
    "extensions/clm.ts",
    "src/lib",
    "src/features/live-context",
    "dsh",
    "dist",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "clm"
  ],
  "pi": {
    "extensions": [
      "./extensions/clm.ts"
    ]
  },
  "main": "./dist/dsh/index.js",
  "exports": {
    ".": "./dist/dsh/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "build:dsh": "tsc -p tsconfig.dsh.json",
    "build:dsh:plugin": "node scripts/build-dsh-plugin.mjs",
    "check": "node scripts/check-boundaries.mjs && npm run build:dsh && node --experimental-strip-types --check extensions/clm.ts && node --experimental-strip-types --check src/features/live-context/context-format.ts && node --experimental-strip-types --check src/features/live-context/dsh-bridge.ts && node --check dist/dsh/index.js && node --check scripts/build-dsh-plugin.mjs && node scripts/check-dsh-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dsh.json --noEmit",
    "prepack": "npm run build:dsh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
